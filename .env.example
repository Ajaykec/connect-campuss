# Copy this file to ".env" (same folder as this file) and fill in real values.
# NEVER commit ".env" to GitHub.

PORT=3000

# PostgreSQL connection string.
# Local example:    postgresql://postgres:YOUR_PASSWORD@localhost:5432/scopelock
# Supabase example: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=

# Set to true for Supabase (needs SSL). Keep false for local PostgreSQL.
DATABASE_SSL=false

# Impact calculation rules (see backend/services/impactCalculator.js)
HOURLY_RATE=50
WORKING_HOURS_PER_DAY=6
